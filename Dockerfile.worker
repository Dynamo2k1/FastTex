# FastTeX Worker Dockerfile
# Multi-stage build for minimal production image with LaTeX support

# Build stage
FROM rust:1.75-bookworm as builder

WORKDIR /app

# Copy Cargo files first for dependency caching
COPY Cargo.toml Cargo.lock ./
COPY gateway/Cargo.toml ./gateway/
COPY worker/Cargo.toml ./worker/
COPY orchestrator/Cargo.toml ./orchestrator/

# Create dummy source files for dependency compilation
RUN mkdir -p gateway/src worker/src orchestrator/src && \
    echo "fn main() {}" > gateway/src/main.rs && \
    echo "fn main() {}" > worker/src/main.rs && \
    echo "fn main() {}" > orchestrator/src/main.rs && \
    touch gateway/src/lib.rs worker/src/lib.rs orchestrator/src/lib.rs

# Build dependencies only
RUN cargo build --release --package fasttex-worker 2>/dev/null || true

# Copy actual source code
COPY gateway ./gateway
COPY worker ./worker
COPY orchestrator ./orchestrator

# Touch source files to trigger rebuild
RUN touch worker/src/main.rs worker/src/lib.rs

# Build the release binary
RUN cargo build --release --package fasttex-worker

# Runtime stage
FROM debian:bookworm-slim

# Install LaTeX and required packages
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-science \
    texlive-pictures \
    latexmk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/target/release/fasttex-worker /usr/local/bin/

# Create non-root user with working directory
RUN useradd -r -s /bin/false fasttex && \
    mkdir -p /tmp/fasttex-work && \
    chown fasttex:fasttex /tmp/fasttex-work

USER fasttex

ENV WORKER_WORK_DIR=/tmp/fasttex-work

ENTRYPOINT ["fasttex-worker"]
